# Neon / Postgres 连接串（用于进度与复习队列；不配置时构建仍可通过）
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# 站点对外地址（sitemap / canonical / OG）
NEXT_PUBLIC_SITE_URL="https://gis.ason.top"

# 账号系统密钥：scrypt pepper + 会话 HMAC 签名，≥32 字符
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 生产环境缺失会直接报错；开发环境缺失时使用进程内临时值（重启即登出）
AUTH_SECRET=""

# 自托管且位于受信反向代理后时置 1，限流才采信 X-Forwarded-For；Vercel 无需配置
TRUST_PROXY=""
