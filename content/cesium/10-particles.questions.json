      "id": "cesium-10-001",
      "skill": "cesium",
      "module": "10",
      "difficulty": 1,
      "stem": "粒子系统（ParticleSystem）挂载到场景的正确 API 是？",
      "explanation": "粒子系统属于渲染原语层（第 7 章 3D Tiles 同款容器）：viewer.scene.primitives.add。Entity/dataSources/imageryLayers 都不是它的家。",
      "refs": [
        {
          "title": "Cesium.ParticleSystem API 参考",
          "url": "https://cesium.com/reference/cesiumjs/latest/Cesium.ParticleSystem.html"
        }
      ],
      "type": "single",
      "options": [
        {
          "key": "A",
          "text": "viewer.entities.add(particleSystem)"
        },
        {
          "key": "B",
          "text": "viewer.imageryLayers.add(particleSystem)"
        },
        {
          "key": "C",
          "text": "viewer.scene.primitives.add(particleSystem)",
          "hint": "粒子是渲染原语，与 3D Tiles 同容器"
        },
        {
          "key": "D",
          "text": "viewer.dataSources.add(particleSystem)"
        }
      ],
      "answer": [
        "C"
      ]
    },
