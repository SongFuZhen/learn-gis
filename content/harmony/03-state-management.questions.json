      "refs": [
        {
          "title": "状态管理概述",
          "url": "https://developer.huawei.com/consumer/cn/doc/harmonyos-guides/arkts-state-management-overview"
        },
        {
          "title": "@State：组件内状态",
          "url": "https://developer.huawei.com/consumer/cn/doc/harmonyos-references/ts-state-management-state"
        }
      ],
      "type": "single",
      "options": [
        {
          "key": "A",
          "text": "Child({ score: this.$score })"
        },
        {
          "key": "B",
          "text": "Child({ score: 60 })"
        },
        {
          "key": "C",
          "text": "Child({ score: this.score })"
        },
