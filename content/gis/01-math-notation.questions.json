    {
      "id": "gis-01-001",
      "skill": "gis",
      "module": "01",
      "difficulty": 1,
      "stem": "直角三角形中，sin θ 的定义是？",
      "explanation": "sin θ = 对边 / 斜边。口诀 SOH-CAH-TOA 的 S-O-H：Sin = Opposite / Hypotenuse。cos 是邻比斜，tan 是对比邻。",
      "refs": [
        {
          "title": "Trigonometric functions — Wikipedia",
          "url": "https://en.wikipedia.org/wiki/Trigonometric_functions"
        }
      ],
      "type": "single",
      "options": [
        {
          "text": "对边 ÷ 斜边",
          "hint": "这是 sin 的定义，SOH 口诀的第一条。",
          "key": "A"
        },
        {
          "text": "邻边 ÷ 斜边",
          "hint": "邻比斜是 cos（余弦），不是 sin。",
          "key": "B"
        },
        {
          "text": "对边 ÷ 邻边",
          "hint": "对比邻是 tan（正切）。",
          "key": "C"
        },
        {
          "text": "斜边 ÷ 对边",
          "hint": "这是 sin 的倒数（cosec），初学用不到。",
          "key": "D"
        }
      ],
      "answer": [
        "A"
      ]
    },
